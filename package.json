{
  "name": "leva-engine",
  "private": true,
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild app/javascript/leva/application.js --bundle --sourcemap --outdir=app/assets/builds/leva",
    "build:css": "tailwindcss -i app/assets/stylesheets/leva/application.tailwind.css -o app/assets/builds/leva/application.tailwind.css --config config/tailwind.config.js",
    "watch": "npm-run-all --parallel watch:js watch:css",
    "watch:js": "esbuild app/javascript/leva/application.js --bundle --sourcemap --outdir=app/assets/builds/leva --watch",
    "watch:css": "tailwindcss -i app/assets/stylesheets/leva/application.tailwind.css -o app/assets/builds/leva/application.tailwind.css --config config/tailwind.config.js --watch"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/stimulus-loading": "^1.2.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "esbuild": "^0.21.5",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.10"
  }
}
