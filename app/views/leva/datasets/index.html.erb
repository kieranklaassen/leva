<% content_for :title, 'Datasets' %>

<div class="container py-8">
  <div class="split mb-6">
    <h1 class="text-accent mb-0">Datasets</h1>

    <%= render "leva/shared/button",
      text: "Create New Dataset",
      href: new_dataset_path,
      variant: "primary" %>
  </div>

  <% if @datasets.any? %>
    <div class="card p-0">
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Description</th>
              <th>Records</th>
              <th>Experiments</th>
              <th class="sr-only">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= render @datasets %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <%= render "leva/shared/empty_state",
      icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>',
      title: "No datasets yet",
      description: "Get started by creating a new dataset.",
      button_text: "Create your first dataset",
      button_href: new_dataset_path %>
  <% end %>
</div>
