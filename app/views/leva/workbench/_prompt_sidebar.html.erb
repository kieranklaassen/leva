<div class="flex flex-col" style="height: 100%;">
  <div class="p-4">
    <h2 class="text-accent mb-4" style="font-size: 1.25rem; font-weight: 700;">Prompts</h2>
    <div class="stack gap-2">
      <% prompts.each do |prompt| %>
        <% is_selected = prompt == selected_prompt %>
        <%= link_to workbench_index_path(prompt_id: prompt.id),
          class: "card p-3 #{'card-elevated' if is_selected}",
          style: is_selected ? "background: var(--amber-600); color: var(--neutral-950);" : "" do %>
          <span class="text-sm font-medium"><%= prompt.name %></span>
          <span class="text-xs ml-2" style="<%= is_selected ? 'color: var(--neutral-950);' : 'color: var(--amber-400);' %>">
            v<%= prompt.version %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
  <div style="margin-top: auto;" class="p-4">
    <%= link_to "New Prompt", new_workbench_path, class: "btn btn-primary", style: "width: 100%; display: flex; align-items: center; justify-content: center;" %>
  </div>
</div>
