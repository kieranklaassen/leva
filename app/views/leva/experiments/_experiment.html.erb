<tr>
  <td>
    <%= link_to experiment.name, experiment_path(experiment), style: "color: var(--amber-400);" %>
  </td>
  <td>
    <% status_color = case experiment.status
       when 'pending' then 'background: var(--amber-200); color: var(--neutral-950);'
       when 'running' then 'background: var(--blue-200); color: var(--neutral-950);'
       when 'completed' then 'background: var(--green-200); color: var(--neutral-950);'
       when 'failed' then 'background: var(--red-200); color: var(--neutral-950);'
       else 'background: var(--neutral-200); color: var(--neutral-950);'
       end %>
    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full" style="<%= status_color %>">
      <%= experiment.status&.capitalize || 'N/A' %>
    </span>
  </td>
  <td class="text-muted">
    <%= experiment.runner_results.count %>
  </td>
  <% Leva::EvaluationResult.distinct.pluck(:evaluator_class).each do |evaluator_class| %>
    <td>
      <% results = experiment.evaluation_results.where(evaluator_class: evaluator_class) %>
      <% if results.any? %>
        <% avg_score = (results.sum(&:score) / results.size.to_f).round(2) %>
        <% score_class = avg_score >= 0.7 ? "score-high" : (avg_score >= 0.4 ? "score-mid" : "score-low") %>
        <span class="text-mono <%= score_class %>" style="font-weight: 600;">
          <%= sprintf('%.2f', avg_score) %>
        </span>
      <% else %>
        <span class="text-muted">N/A</span>
      <% end %>
    </td>
  <% end %>
  <td class="text-right">
    <%= link_to 'View Results', experiment_path(experiment), style: "color: var(--amber-400);" %>
  </td>
</tr>
