<%
# Alert partial - Laboratory Elegance Design System
#
# Usage:
#   <%= render "leva/shared/alert",
#     variant: "error",
#     title: "Error",
#     message: "Something went wrong." %>
#
#   <%= render "leva/shared/alert", variant: "success" do %>
#     <p>Custom HTML content</p>
#   <% end %>
#
# Parameters:
#   variant: error | success | info (default: info)
#   title:   Alert heading (optional)
#   message: Alert text (optional, or use block)
#   dismissible: Boolean, adds close button (default: false)

variant ||= "info"
dismissible ||= false
title ||= nil
message ||= nil

variant_classes = {
  error: "border-error/50 bg-error/10",
  success: "border-success/50 bg-success/10",
  info: "border-amber-700/50 bg-amber-900/10"
}

icon_color = {
  error: "var(--error)",
  success: "var(--success)",
  info: "var(--amber-500)"
}

text_color = {
  error: "var(--error)",
  success: "var(--success)",
  info: "var(--amber-400)"
}
-%>

<div class="card <%= variant_classes[variant.to_sym] %>"
     role="alert"
     aria-live="polite"
     style="padding: var(--space-4);">

  <div class="flex gap-3">
    <%# Icon %>
    <div class="flex-shrink-0" style="width: 1.5rem; height: 1.5rem; color: <%= icon_color[variant.to_sym] %>;">
      <% if variant.to_sym == :error %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
      <% elsif variant.to_sym == :success %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
      <% else %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
        </svg>
      <% end %>
    </div>

    <%# Content %>
    <div class="flex-1" style="min-width: 0;">
      <% if title.present? %>
        <h4 class="mb-2" style="font-size: 0.9375rem; font-weight: 500; color: <%= text_color[variant.to_sym] %>;">
          <%= title %>
        </h4>
      <% end %>

      <div class="text-muted" style="font-size: 0.875rem;">
        <% if block_given? %>
          <%= yield %>
        <% elsif message.present? %>
          <%= message %>
        <% end %>
      </div>
    </div>

    <%# Dismiss button %>
    <% if dismissible %>
      <button type="button"
              class="btn-ghost"
              style="padding: 0; min-height: auto; width: 1.5rem; height: 1.5rem; color: var(--neutral-400);"
              aria-label="Dismiss"
              onclick="this.closest('[role=alert]').remove()">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" style="width: 1.25rem; height: 1.25rem;">
          <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
        </svg>
      </button>
    <% end %>
  </div>
</div>
